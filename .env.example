# Open Meetings environment. Copy to .env and fill in what your profile needs.
# `om init` writes a .env with fresh tokens for you. Never commit the real .env.

# ── Access ─────────────────────────────────────────────────────────────────────
# Token for the panel and every API (Authorization: Bearer ...). Required whenever the
# server is reachable from another machine. Generate: openssl rand -hex 32
OM_AUTH_TOKEN=

# Shared secret between the server and the bot process (Docker: both containers read it).
OM_BOT_TOKEN=

# ── Which config ───────────────────────────────────────────────────────────────
# Path of the config file. Docker picks one when empty: a mounted openmeetings.config.yaml,
# else examples/local.yaml with `--profile local`, else examples/cloud-cheap.yaml.
OM_CONFIG=

# ── Model providers (only the ones your profile uses) ───────────────────────────
# cloud-cheap: fast model on Groq.
GROQ_API_KEY=
# cloud-cheap, cloud-best, hybrid: Claude.
ANTHROPIC_API_KEY=
# cloud-best: voice and embeddings on OpenAI.
OPENAI_API_KEY=

# ── Local engines (profile local / hybrid outside Docker) ───────────────────────
# OpenAI-compatible base URLs. Defaults: Ollama on 11434, Speaches on 8000.
# OLLAMA_URL=http://localhost:11434/v1
# STT_URL=http://localhost:8000/v1

# ── Outputs ────────────────────────────────────────────────────────────────────
# Receives { event: "meeting.ended", meeting, minutes, state } when a meeting ends
# (enable with outputs.postSummaryTo: [chat, webhook]).
OM_WEBHOOK_URL=

# ── Deployment overrides (win over the config file) ─────────────────────────────
# OM_HOST=127.0.0.1         # 0.0.0.0 inside containers
# OM_PORT=4319
# OM_DB_PATH=./data/openmeetings.db
# OM_BOT_SPAWN=true          # false when the bot runs in its own container
# OM_BOT_HEADLESS=true
# OM_LOG_LEVEL=info

# ── om join / om acp against a remote server ────────────────────────────────────
# OM_SERVER_URL=http://localhost:4319

# ── Bot process (only when running apps/bot by hand) ────────────────────────────
# OM_SERVER_WS=ws://127.0.0.1:4319/bot

# ── Selector smoke test (CI secret) ─────────────────────────────────────────────
# OM_SMOKE_MEET_URL=https://meet.google.com/xxx-yyyy-zzz
