{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/__snapshots__",
      "!fixtures/**/*.json",
      "!apps/bot/test/fake-meet.html",
      "!CHANGELOG.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/extension/src/manifest.json",
        "**/package.json",
        ".release-please-manifest.json"
      ],
      "json": { "formatter": { "expand": "always" } }
    },
    {
      "includes": ["packages/config/src/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
